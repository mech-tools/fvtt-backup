{
  "id": "share-media",
  "title": "Share Media",
  "description": "This module allows GMs to quickly share media.",
  "version": "2.13.7",
  "manifest": "https://github.com/mech-tools/share-media/releases/latest/download/module.json",
  "download": "https://github.com/mech-tools/share-media/releases/download/2.13.7/module.zip",
  "url": "https://github.com/mech-tools/share-media",
  "readme": "https://github.com/mech-tools/share-media/blob/master/README.md",
  "changelog": "https://github.com/mech-tools/share-media/releases",
  "bugs": "https://github.com/mech-tools/share-media/issues",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Maxime",
      "url": "https://github.com/mech-tools",
      "discord": "Maxime1562",
      "flags": {}
    }
  ],
  "esmodules": [
    "share-media.mjs"
  ],
  "styles": [
    {
      "src": "share-media.css"
    }
  ],
  "documentTypes": {
    "RegionBehavior": {
      "ShareRegion": {}
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json",
      "flags": {}
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "languages/fr.json",
      "flags": {}
    },
    {
      "lang": "ja",
      "name": "日本語",
      "path": "languages/ja.json",
      "flags": {}
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "share-media.css",
        "templates/",
        "languages/"
      ]
    }
  },
  "socket": true
}