<form autocomplete="off">
  <div class="roidesgobelins-mod">
      <div class="roidesgobelins-forms">
        <table>
          <tbody>
            <tr class="objectif-titre"style="border-bottom: solid;">
            <th>Joueuse / Joueur</th>
            <th>Personnage</th>
            <th>Objectif</th>
          </tr>
          <tr>
            <td class="objectif-titre">Scénario 1</td>
            <td colspan="2">
              {{#if formdata.isGM}}
              <button class="button reroll-objectif" name="button" data-field="scenario1">Attribuer aléatoirement</button>
              {{/if}}</td>
          </tr>
          {{#each formdata.user as |user id|}}
          <tr>
            <td class="objectif-titre">{{user.name}}</td>
            {{#if ../formdata.isGM}}
            <td><input class="input-long" name="inputtext" data-field="charname" data-id={{user.id}} data-group="scenario1" type="text" value="{{user.scenario1.charname}}" /></td>
            <td><input class="input-long" name="inputtext" data-field="objectif" data-id={{user.id}} data-group="scenario1" type="text" value="{{user.scenario1.objectif}}" /></td>
            {{else}}
            <td>{{user.scenario1.charname}}</td>
            <td>{{user.scenario1.objectif}}</td>
            {{/if}}
